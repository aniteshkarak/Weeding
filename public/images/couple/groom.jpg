<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 650" width="500" height="650">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFFDF8"/>
      <stop offset="50%" stop-color="#F7F3EB"/>
      <stop offset="100%" stop-color="#E9DFCE"/>
    </linearGradient>
    <linearGradient id="gold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#B69A65"/>
      <stop offset="50%" stop-color="#E5C578"/>
      <stop offset="100%" stop-color="#8C713F"/>
    </linearGradient>
  </defs>

  <rect width="100%" height="100%" fill="url(#bgGrad)"/>
  
  <rect x="20" y="20" width="460" height="610" rx="4" fill="none" stroke="#B69A65" stroke-width="1.2" stroke-opacity="0.6"/>
  <rect x="28" y="28" width="444" height="594" rx="2" fill="none" stroke="#B69A65" stroke-width="0.8" stroke-dasharray="4,4" stroke-opacity="0.3"/>

  <path d="M 24 44 L 24 24 L 44 24" fill="none" stroke="#B69A65" stroke-width="2"/>
  <path d="M 476 44 L 476 24 L 456 24" fill="none" stroke="#B69A65" stroke-width="2"/>
  <path d="M 24 606 L 24 626 L 44 626" fill="none" stroke="#B69A65" stroke-width="2"/>
  <path d="M 476 606 L 476 626 L 456 626" fill="none" stroke="#B69A65" stroke-width="2"/>

  <g transform="translate(250, 270)">
    <circle cx="0" cy="0" r="100" fill="none" stroke="#B69A65" stroke-width="1" stroke-dasharray="3,3" stroke-opacity="0.5"/>
    <circle cx="0" cy="0" r="90" fill="#FFFDF8" stroke="#B69A65" stroke-width="1.5"/>
    <circle cx="0" cy="0" r="82" fill="none" stroke="#B69A65" stroke-width="0.75" stroke-opacity="0.4"/>
    
    <path d="M -50 -10 Q -60 -40 -35 -55 Q -10 -40 -30 -20 Z" fill="#B69A65" fill-opacity="0.15"/>
    <path d="M 50 -10 Q 60 -40 35 -55 Q 10 -40 30 -20 Z" fill="#B69A65" fill-opacity="0.15"/>

    <text x="0" y="28" text-anchor="middle" font-family="'Playfair Display', Georgia, serif" font-size="76" font-weight="700" fill="url(#gold)">R</text>
  </g>

  <text x="250" y="440" text-anchor="middle" font-family="'Playfair Display', Georgia, serif" font-size="28" font-weight="600" fill="#29251F" letter-spacing="4">REON</text>
  <text x="250" y="475" text-anchor="middle" font-family="'Inter', sans-serif" font-size="12" font-weight="500" fill="#81786B" letter-spacing="3">THE HANDSOME GROOM</text>

  <line x1="180" y1="510" x2="320" y2="510" stroke="#B69A65" stroke-width="1" stroke-opacity="0.5"/>
  <circle cx="250" cy="510" r="3" fill="#B69A65"/>

  <text x="250" y="555" text-anchor="middle" font-family="'Inter', monospace" font-size="11" fill="#81786B" fill-opacity="0.7">public/images/couple/groom.jpg</text>
</svg>